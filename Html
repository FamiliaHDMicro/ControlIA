<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PrevData - Reconhecimento de Voz</title>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background-color: #1e293b;
            padding: 30px;
            border-radius: 16px;
            text-align: center;
            max-width: 400px;
            width: 90%;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        h1 { color: #38bdf8; margin-bottom: 8px; }
        p { color: #94a3b8; font-size: 0.95rem; }
        button {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            margin: 25px 0;
            transition: 0.2s;
        }
        button:hover { background-color: #1d4ed8; }
        .caixa-texto {
            background-color: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 15px;
            min-height: 80px;
            text-align: left;
            color: #e2e8f0;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>PrevData</h1>
        <p>Clique no botão e comece a falar</p>

        <button id="btnOuvir">🎤 Ouvir Voz</button>

        <div id="status" style="color: #38bdf8; margin-bottom: 10px;"></div>
        <div id="resultado" class="caixa-texto">Sua fala aparecerá aqui...</div>
    </div>

    <script>
        const btn = document.getElementById('btnOuvir');
        const resultado = document.getElementById('resultado');
        const status = document.getElementById('status');

        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

        if (SpeechRecognition) {
            const gravador = new SpeechRecognition();
            gravador.lang = 'pt-BR';

            btn.onclick = () => {
                gravador.start();
                status.innerText = "Ouvindo... PODE FALAR!";
            };

            gravador.onresult = (e) => {
                resultado.innerText = e.results[0][0].transcript;
                status.innerText = "Voz capturada com sucesso!";
            };

            gravador.onerror = () => {
                status.innerText = "Erro ao acessar o microfone.";
            };
        } else {
            status.innerText = "Navegador sem suporte a voz. Use Chrome ou Edge.";
        }
    </script>

</body>
</html>
